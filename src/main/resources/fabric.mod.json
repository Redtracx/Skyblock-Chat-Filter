      "com.redtracx.skyblockchatfilter.SkyblockChatFilterClient"
    ],
    "modmenu": [
      "com.redtracx.skyblockchatfilter.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "skyblockchatfilter.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.5",
