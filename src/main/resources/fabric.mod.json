{
  "schemaVersion": 1,
  "id": "skyblockchatfilter",
  "version": "${version}",
  "name": "Skyblock Chat-Filter",
  "description": "An intelligent Skyblock Chat-Filter for 1.21.x",
  "authors": [
    "redtracx"
  ],
  "contact": {
    "repo": "https://github.com/redtracx/Skyblock-Chat-Filter"
  },
  "license": "MIT",
  "icon": "assets/skyblockchatfilter/icon.png",
