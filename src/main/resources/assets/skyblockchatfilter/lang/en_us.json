{
  "text.autoconfig.skyblockchatfilter.title": "Skyblock Chat-Filter Configuration",

  "text.autoconfig.skyblockchatfilter.category.general": "General Filters",
  "text.autoconfig.skyblockchatfilter.category.trading": "Trading & Economy",
  "text.autoconfig.skyblockchatfilter.category.social": "Party & Guild",
  "text.autoconfig.skyblockchatfilter.category.combat": "Combat & Pets",
  "text.autoconfig.skyblockchatfilter.category.chattabs": "Chat Tabs",
  "text.autoconfig.skyblockchatfilter.category.dungeons": "Dungeon Filters",

  "text.autoconfig.skyblockchatfilter.option.hideHubTrades": "Hide Hub Trades",
  "text.autoconfig.skyblockchatfilter.option.hideHubTrades.@Tooltip[0]": "Hides messages from people wanting to sell/buy items.",
  "text.autoconfig.skyblockchatfilter.option.hideHubTrades.@Tooltip[1]": "Example: '[VIP] Player: selling adaptive helm /ah'",

  "text.autoconfig.skyblockchatfilter.option.hideLowballing": "Hide Lowballing",
  "text.autoconfig.skyblockchatfilter.option.hideLowballing.@Tooltip[0]": "Hides lowballing advertisements from the chat.",
  "text.autoconfig.skyblockchatfilter.option.hideLowballing.@Tooltip[1]": "Example: '[MVP+] Player: lb 200m sowas'",

  "text.autoconfig.skyblockchatfilter.option.hideRngPopups": "Hide RNG Drop Popups",
  "text.autoconfig.skyblockchatfilter.option.hideRngPopups.@Tooltip[0]": "Hides server-wide RNG drop broadcast messages.",
  "text.autoconfig.skyblockchatfilter.option.hideRngPopups.@Tooltip[1]": "Example: 'CRAZY RARE DROP! Player obtained 1x Handle'",

  "text.autoconfig.skyblockchatfilter.option.hideLobbyJoinMessages": "Hide Lobby Join Messages",
  "text.autoconfig.skyblockchatfilter.option.hideLobbyJoinMessages.@Tooltip[0]": "Hides the messages of players joining the server lobby.",
  "text.autoconfig.skyblockchatfilter.option.hideLobbyJoinMessages.@Tooltip[1]": "Example: '[MVP+] Player joined the lobby!'",

  "text.autoconfig.skyblockchatfilter.option.hideMysteryBoxMessages": "Hide Mystery Box Found",
  "text.autoconfig.skyblockchatfilter.option.hideMysteryBoxMessages.@Tooltip[0]": "Hides the message whenever you or someone else finds a Mystery Box.",
  "text.autoconfig.skyblockchatfilter.option.hideMysteryBoxMessages.@Tooltip[1]": "Example: 'Player found a Mystery Box!'",

  "text.autoconfig.skyblockchatfilter.option.hideProfileIdMessages": "Hide Profile ID Spam",
  "text.autoconfig.skyblockchatfilter.option.hideProfileIdMessages.@Tooltip[0]": "Hides the Profile ID string printed when joining a Skyblock world.",
  "text.autoconfig.skyblockchatfilter.option.hideProfileIdMessages.@Tooltip[1]": "Example: 'Profile ID: a3b8d1b6-0b3b-4b1a'",

  "text.autoconfig.skyblockchatfilter.option.hideSendingToServer": "Hide Server Transfers",
  "text.autoconfig.skyblockchatfilter.option.hideSendingToServer.@Tooltip[0]": "Hides the 'Sending to server X' text.",
  "text.autoconfig.skyblockchatfilter.option.hideSendingToServer.@Tooltip[1]": "Example: 'Sending to server mini72J...'",

  "text.autoconfig.skyblockchatfilter.option.hideMinionSpeech": "Hide Minion Text",
  "text.autoconfig.skyblockchatfilter.option.hideMinionSpeech.@Tooltip[0]": "Hides the text minions say above their heads, like when full.",
  "text.autoconfig.skyblockchatfilter.option.hideMinionSpeech.@Tooltip[1]": "Example: 'My storage is full!'",

  "text.autoconfig.skyblockchatfilter.option.hideEventAnnouncements": "Hide Skyblock Events",
  "text.autoconfig.skyblockchatfilter.option.hideEventAnnouncements.@Tooltip[0]": "Hides event reminder messages (Spooky Festival, Dark Auction, etc).",
  "text.autoconfig.skyblockchatfilter.option.hideEventAnnouncements.@Tooltip[1]": "Example: 'The Dark Auction is starting!'",

  "text.autoconfig.skyblockchatfilter.option.hideFastClickWarnings": "Hide 'Clicking Too Fast'",
  "text.autoconfig.skyblockchatfilter.option.hideFastClickWarnings.@Tooltip[0]": "Hides the spammy block placement cancel warnings.",
  "text.autoconfig.skyblockchatfilter.option.hideFastClickWarnings.@Tooltip[1]": "Example: 'Placing blocks too fast!' or 'This is a little fast.'",

  "text.autoconfig.skyblockchatfilter.option.hideCoopChatter": "Hide Co-op Chat",
  "text.autoconfig.skyblockchatfilter.option.hideCoopChatter.@Tooltip[0]": "Hides all messages sent in the co-op chat channel.",
  "text.autoconfig.skyblockchatfilter.option.hideCoopChatter.@Tooltip[1]": "Example: 'Co-op > Player: hello'",

  "text.autoconfig.skyblockchatfilter.option.hideDungeonBlessings": "Hide Dungeon Blessings",
  "text.autoconfig.skyblockchatfilter.option.hideDungeonBlessings.@Tooltip[0]": "Hides the blessing pickup messages as well as the granted stats.",
  "text.autoconfig.skyblockchatfilter.option.hideDungeonBlessings.@Tooltip[1]": "Example: 'A Blessing of Life was picked up!'",

  "text.autoconfig.skyblockchatfilter.option.hideEssenceDrops": "Hide Essence Drops",
  "text.autoconfig.skyblockchatfilter.option.hideEssenceDrops.@Tooltip[0]": "Hides chat prints related to finding essences in dungeons.",
  "text.autoconfig.skyblockchatfilter.option.hideEssenceDrops.@Tooltip[1]": "Example: 'You found a Wither Essence!'",

  "text.autoconfig.skyblockchatfilter.option.hideWatcherSpam": "Hide Watcher Spam",
  "text.autoconfig.skyblockchatfilter.option.hideWatcherSpam.@Tooltip[0]": "Hides Watcher's dialogue lines, leaving only important stage calls.",
  "text.autoconfig.skyblockchatfilter.option.hideWatcherSpam.@Tooltip[1]": "Example: '[BOSS] The Watcher: interesting...'",

  "text.autoconfig.skyblockchatfilter.option.hideScamAdverts": "Hide Scam Adverts",
  "text.autoconfig.skyblockchatfilter.option.hideScamAdverts.@Tooltip[0]": "Hides quitting, giveaway and other scam attempts.",
  "text.autoconfig.skyblockchatfilter.option.hideScamAdverts.@Tooltip[1]": "Example: 'QUITTING SKYBLOCK! Giving away 50m /visit Player'",

  "text.autoconfig.skyblockchatfilter.option.hideCarryAdverts": "Hide Carry Adverts",
  "text.autoconfig.skyblockchatfilter.option.hideCarryAdverts.@Tooltip[0]": "Hides messages selling dungeon or Kuudra carries.",
  "text.autoconfig.skyblockchatfilter.option.hideCarryAdverts.@Tooltip[1]": "Example: 'Selling F7 S+ Carry 5m'",

  "text.autoconfig.skyblockchatfilter.option.hidePetMessages": "Hide Pet Messages",
  "text.autoconfig.skyblockchatfilter.option.hidePetMessages.@Tooltip[0]": "Hides Autopet equipping and Pet Level-Up.",
  "text.autoconfig.skyblockchatfilter.option.hidePetMessages.@Tooltip[1]": "Example: 'Autopet equipped your [Lvl 100] Squid!'",

  "text.autoconfig.skyblockchatfilter.option.hideAbilityMessages": "Hide Ability Feedback",
  "text.autoconfig.skyblockchatfilter.option.hideAbilityMessages.@Tooltip[0]": "Hides ability chatter like 'Not enough mana!'",
  "text.autoconfig.skyblockchatfilter.option.hideAbilityMessages.@Tooltip[1]": "Example: 'Not enough mana! (50 Mana required)'",

  "text.autoconfig.skyblockchatfilter.option.hideKuudraActionSpam": "Hide Kuudra Spam",
  "text.autoconfig.skyblockchatfilter.option.hideKuudraActionSpam.@Tooltip[0]": "Hides excessive action text in Kuudra boss fights.",
  "text.autoconfig.skyblockchatfilter.option.hideKuudraActionSpam.@Tooltip[1]": "Example: 'Player has recovered a Supply!'",

  "text.autoconfig.skyblockchatfilter.option.hideFireSales": "Hide Fire Sales",
  "text.autoconfig.skyblockchatfilter.option.hideFireSales.@Tooltip[0]": "Hides announcements about cosmetic Fire Sales.",
  "text.autoconfig.skyblockchatfilter.option.hideFireSales.@Tooltip[1]": "Example: '[Fire Sale] The Warden Helmet Skin Fire Sale is starting!'",

  "text.autoconfig.skyblockchatfilter.option.hideStashMessages": "Hide Stash Messages",
  "text.autoconfig.skyblockchatfilter.option.hideStashMessages.@Tooltip[0]": "Hides messages telling you that items are in your stash.",
  "text.autoconfig.skyblockchatfilter.option.hideStashMessages.@Tooltip[1]": "Example: 'You have 1 item(s) stashed away!'",

  "text.autoconfig.skyblockchatfilter.option.hideBossDialogue": "Hide Boss Dialogue",
  "text.autoconfig.skyblockchatfilter.option.hideBossDialogue.@Tooltip[0]": "Globally hides chat from bosses (e.g. Sadan, Necron, M7 Dragons).",
  "text.autoconfig.skyblockchatfilter.option.hideBossDialogue.@Tooltip[1]": "Example: '[BOSS] Necron: Finally, a worthy opponent!'",

  "text.autoconfig.skyblockchatfilter.option.hideBankInterest": "Hide Bank Interest",
  "text.autoconfig.skyblockchatfilter.option.hideBankInterest.@Tooltip[0]": "Hides the periodic coin interest payout message from your Bank.",
  "text.autoconfig.skyblockchatfilter.option.hideBankInterest.@Tooltip[1]": "Example: 'You have received 4,213 coins in Bank Interest!'",

  "text.autoconfig.skyblockchatfilter.option.hideAuctionHouseNotifications": "Hide Auction House Notifications",
  "text.autoconfig.skyblockchatfilter.option.hideAuctionHouseNotifications.@Tooltip[0]": "Hides your own Auction House sold/outbid/purchase confirmations.",
  "text.autoconfig.skyblockchatfilter.option.hideAuctionHouseNotifications.@Tooltip[1]": "Example: 'Auction House > Your auction for Hyperion has sold!'",

  "text.autoconfig.skyblockchatfilter.option.hideTradeNotifications": "Hide Trade Notifications",
  "text.autoconfig.skyblockchatfilter.option.hideTradeNotifications.@Tooltip[0]": "Hides trade completed/cancelled confirmation messages.",
  "text.autoconfig.skyblockchatfilter.option.hideTradeNotifications.@Tooltip[1]": "Example: 'Trade completed with Player!'",

  "text.autoconfig.skyblockchatfilter.option.hidePartyNotifications": "Hide Party Notifications",
  "text.autoconfig.skyblockchatfilter.option.hidePartyNotifications.@Tooltip[0]": "Hides party join/leave/kick/disband spam. Actual party chat still shows.",
  "text.autoconfig.skyblockchatfilter.option.hidePartyNotifications.@Tooltip[1]": "Example: 'Player has joined the party!'",

  "text.autoconfig.skyblockchatfilter.option.hideGuildNotifications": "Hide Guild Notifications",
  "text.autoconfig.skyblockchatfilter.option.hideGuildNotifications.@Tooltip[0]": "Hides guild join/leave/promotion/demotion spam. Actual guild chat still shows.",
  "text.autoconfig.skyblockchatfilter.option.hideGuildNotifications.@Tooltip[1]": "Example: 'Guild > Player has joined the guild!'",

  "text.autoconfig.skyblockchatfilter.option.enableChatTabs": "Enable Chat Tabs",
  "text.autoconfig.skyblockchatfilter.option.enableChatTabs.@Tooltip[0]": "Adds a clickable All/Party/Guild/Co-op/DMs tab bar to the chat window. Turn off to disable the tab bar entirely and see unfiltered chat.",
  "text.autoconfig.skyblockchatfilter.option.enableChatTabs.@Tooltip[1]": "Click a tab or scroll over the bar to switch tabs. Off by default."
}
